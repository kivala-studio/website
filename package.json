{
  "name": "invest-ao-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/statement-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/statement-assets.mjs",
    "build": "next build && node scripts/scan-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "scan:bundle": "node scripts/scan-client-bundle.mjs",
    "e2e": "playwright test",
    "e2e:local": "playwright test -c playwright.local.config.ts",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "messages": "node scripts/convert-messages.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "intelligence:evaluate": "INTELLIGENCE_EVALUATION_OUTPUT=docs/evidence/w14/web-intelligence-evaluation.json vitest run src/domain/intelligence/evaluation"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "decimal.js": "10.6.0",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
