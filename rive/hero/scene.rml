<Rive version="1" kind="fragment">
    <!--
        The landing hero's background shapes. The artboard is transparent (the panel's fill is the page's
        `stage-deep`) and is laid out at the canvas's own size, so each shape hangs off a 1 pt box pinned to an edge.
        Colours are `stage-brand` (5A9BFF) and `on-stage-deep` (F5F7FA), the same in both themes.
        One 20 s loop: every key returns to its frame-0 value, so the seam does not show.
    -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="1440" height="810" clip="true" name="Hero" id="0:2">
        <LayoutComponentStyle name="Hero Style" id="0:5"/>

        <LayoutComponent clip="false" width="1" height="1" styleId="1:11" name="Pill Anchor" id="1:10">
            <LayoutComponentStyle positionTypeValue="absolute"
                positionTop="16" positionTopUnitsValue="percent"
                positionLeft="7" positionLeftUnitsValue="percent"
                name="Pill Anchor Style" id="1:11"/>
            <Node name="Free">
            <Shape x="56" y="24" rotation="-0.1047" name="Pill" id="1:12">
                <Rectangle originX="0.5" originY="0.5" width="112" height="48" cornerRadiusTL="24" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="1AF5F7FA" name="Color"/>
                </Fill>
            </Shape>
            </Node>
        </LayoutComponent>

        <LayoutComponent clip="false" width="1" height="1" styleId="1:21" name="Square Anchor" id="1:20">
            <LayoutComponentStyle positionTypeValue="absolute"
                positionTop="0" positionTopUnitsValue="points"
                positionRight="8" positionRightUnitsValue="percent"
                name="Square Anchor Style" id="1:21"/>
            <Node name="Free">
            <Shape x="-112" y="56" rotation="0.2094" name="Square" id="1:22">
                <Rectangle originX="0.5" originY="0.5" width="224" height="224" cornerRadiusTL="48" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="735A9BFF" name="Color"/>
                </Fill>
            </Shape>
            </Node>
        </LayoutComponent>

        <LayoutComponent clip="false" width="1" height="1" styleId="1:31" name="Circle Anchor" id="1:30">
            <LayoutComponentStyle positionTypeValue="absolute"
                positionBottom="0" positionBottomUnitsValue="points"
                positionLeft="0" positionLeftUnitsValue="points"
                name="Circle Anchor Style" id="1:31"/>
            <Node name="Free">
            <Shape x="96" y="-64" name="Circle" id="1:32">
                <Ellipse originX="0.5" originY="0.5" width="384" height="384" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="4D5A9BFF" name="Color"/>
                </Fill>
            </Shape>
            </Node>
        </LayoutComponent>

        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <AnimationState x="200" animationId="0:6" id="0:12"/>
            </StateMachineLayer>
        </StateMachine>

        <LinearAnimation loopValue="loop" fps="60" duration="1200" name="Drift" id="0:6">
            <!-- Circle: one slow rise and swell per loop. -->
            <KeyedObject objectId="1:32">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="-64" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-100" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-64" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="x">
                    <KeyFrameDouble value="96" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="124" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="96" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.08" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.08" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Square: rocks and dips twice per loop. -->
            <KeyedObject objectId="1:22">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.2094" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.3840" frame="300" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.2094" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.3840" frame="900" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.2094" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="y">
                    <KeyFrameDouble value="56" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="80" frame="300" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="56" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="80" frame="900" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="56" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Pill: slides right and tilts back, three times per loop. -->
            <KeyedObject objectId="1:12">
                <KeyedProperty property="x">
                    <KeyFrameDouble value="56" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="92" frame="200" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="56" frame="400" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="92" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="56" frame="800" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="92" frame="1000" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="56" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.1047" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.0524" frame="200" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.1047" frame="400" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.0524" frame="600" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.1047" frame="800" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.0524" frame="1000" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.1047" frame="1200" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
