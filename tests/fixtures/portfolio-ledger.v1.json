      "instruments": { "BAI": "stock" },
      "transactions": [
        { "id": "d1", "security": "BAI", "kind": "buy", "quantity": "10", "unit_price": "50", "fees": "0", "traded_on": "2026-01-05", "created_at": "2026-01-05T10:00:00Z" },
