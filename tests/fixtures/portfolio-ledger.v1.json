        "positions": [
          { "security": "BAI", "quantity": "10", "invested": "500", "average_price": "50", "realized": "0", "net_income": "1350", "current_value": null }
        ],
        "years": [
          { "year": 2026, "realized": "0", "net_income": "450", "fees": "50" },
          { "year": 2025, "realized": "0", "net_income": "900", "fees": "100" }
        ]
      }
    },
    {
