{
  "version": 1,
  "description": "Golden cases for portfolio ledger calculations. Decimals are strings. See docs/portfolio-ledger-contract.md.",
  "cases": [
    {
      "name": "weighted_average_purchases",
      "instruments": { "BAI": "stock" },
      "transactions": [
        { "id": "a1", "security": "BAI", "kind": "buy", "quantity": "50", "unit_price": "45000", "fees": "0", "traded_on": "2026-01-05", "created_at": "2026-01-05T10:00:00Z" },
        { "id": "a2", "security": "BAI", "kind": "buy", "quantity": "30", "unit_price": "55000", "fees": "0", "traded_on": "2026-01-06", "created_at": "2026-01-06T10:00:00Z" },
        { "id": "a3", "security": "BAI", "kind": "buy", "quantity": "20", "unit_price": "61000", "fees": "0", "traded_on": "2026-01-07", "created_at": "2026-01-07T10:00:00Z" }
      ],
      "prices": { "BAI": "60000" },
      "expected": {
        "valid": true,
        "positions": [
          { "security": "BAI", "quantity": "100", "invested": "5120000", "average_price": "51200", "realized": "0", "net_income": "0", "current_value": "6000000" }
        ],
        "years": []
      }
    },
    {
      "name": "fees_raise_cost_and_reduce_proceeds",
      "instruments": { "BAI": "stock" },
      "transactions": [
        { "id": "b1", "security": "BAI", "kind": "buy", "quantity": "10", "unit_price": "50", "fees": "20", "traded_on": "2026-01-05", "created_at": "2026-01-05T10:00:00Z" },
        { "id": "b2", "security": "BAI", "kind": "sell", "quantity": "4", "unit_price": "60", "fees": "8", "traded_on": "2026-02-02", "created_at": "2026-02-02T10:00:00Z" }
      ],
      "prices": { "BAI": "60" },
      "expected": {
        "valid": true,
        "positions": [
          { "security": "BAI", "quantity": "6", "invested": "312", "average_price": "52", "realized": "24", "net_income": "0", "current_value": "360" }
        ],
        "years": [{ "year": 2026, "realized": "24", "net_income": "0", "fees": "28" }]
      }
    },
    {
